{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pepmax.example/schemas/order.schema.json",
  "title": "PepMax Commerce Order",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "status", "currency", "items", "totals", "createdAt"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "status": {"enum": ["pending", "payment_pending", "paid", "processing", "fulfilled", "cancelled", "refunded"]},
    "customerId": {"type": ["string", "null"]},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["productId", "sku", "name", "variantLabel", "unitPrice", "quantity", "lineTotal"],
        "properties": {
          "productId": {"type": "string"},
          "sku": {"type": "string"},
          "name": {"type": "string"},
          "variantLabel": {"type": "string"},
          "unitPrice": {"type": "number", "minimum": 0},
          "quantity": {"type": "integer", "minimum": 1},
          "lineTotal": {"type": "number", "minimum": 0}
        }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subtotal", "discount", "shipping", "tax", "grandTotal"],
      "properties": {
        "subtotal": {"type": "number", "minimum": 0},
        "discount": {"type": "number", "minimum": 0},
        "shipping": {"type": "number", "minimum": 0},
        "tax": {"type": "number", "minimum": 0},
        "grandTotal": {"type": "number", "minimum": 0}
      }
    },
    "payment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {"type": ["string", "null"]},
        "providerPaymentId": {"type": ["string", "null"]},
        "status": {"enum": ["not_started", "pending", "authorized", "paid", "failed", "refunded"]}
      }
    },
    "fulfillment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {"enum": ["unfulfilled", "processing", "shipped", "delivered", "returned"]},
        "carrier": {"type": ["string", "null"]},
        "trackingNumber": {"type": ["string", "null"]},
        "trackingUrl": {"type": ["string", "null"]}
      }
    },
    "createdAt": {"type": "string", "format": "date-time"},
    "updatedAt": {"type": ["string", "null"], "format": "date-time"}
  }
}
